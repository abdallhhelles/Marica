TOKEN=your_discord_bot_token_here
# DISCORD_TOKEN is deprecated; use TOKEN instead.

# Optional AI replies for mentions
MARCIA_AI_API_KEY=
MARCIA_AI_BASE_URL=https://openrouter.ai/api/v1
MARCIA_AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
MARCIA_AI_APP_NAME=Marcia
MARCIA_AI_APP_URL=
MARCIA_MENTION_COOLDOWN=45
MARCIA_BUSY_COOLDOWN=120

# HTTP guardrails
MARCIA_HTTP_TIMEOUT=10
MARCIA_HTTP_RETRIES=2
MARCIA_HTTP_BACKOFF=0.6
MARCIA_HTTP_BREAKER_FAILURES=3
MARCIA_HTTP_BREAKER_RESET=30

# Metrics
MARCIA_METRICS_INTERVAL=120

# Profile scanning
PROFILE_SCAN_WORKERS=1
PROFILE_SCAN_CONCURRENCY=2
PROFILE_SCAN_REVIEW_TIMEOUT=90
OCR_SPACE_API_KEY=
OCR_SPACE_TIMEOUT=60

# Database & storage
MARCIA_DB_PATH=
MARCIA_DB_CACHE_TTL=30
MARCIA_SEED_GUILD_ID=

# Optional bug log channel
BUG_LOG_CHANNEL_ID=
